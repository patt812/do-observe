    {
      "type": "stat",
      "title": "SLA: シャード可用性（推定）",
      "id": 13,
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - ((sum(max by (do) (increase(do_bench_do_deaths_total[$__range]))) / scalar(count(count by (do) (do_bench_conns_connected))) / ($__range_s / 86400)) * 6 / 86400)",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "none",
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 4,
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.999
              },
              {
                "color": "green",
                "value": 0.9995
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "1回の死亡=6秒停止（1秒HB・k=3・即時再接続の設計値）として換算した推定可用性。ベースライン≒99.98%。"
    },
    {
      "type": "stat",
      "title": "SLA: 2時間配信の被弾確率",
      "id": 14,
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - exp(-(sum(max by (do) (increase(do_bench_do_deaths_total[$__range]))) / scalar(count(count by (do) (do_bench_conns_connected))) / ($__range_s / 86400)) * 2 / 24)",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "none",
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.25
              },
              {
                "color": "red",
                "value": 0.4
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "2時間の配信中に自シャードのDO死に1回以上遭遇する確率（ポアソン近似）。ベースライン≒17%。"
    },
